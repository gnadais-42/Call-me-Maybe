# for reproducible installs via `uv sync`.)
.uv/

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Project-specific: generated at runtime, must not be committed per the
# subject ("Do not include the output/ directory in your repository").
data/

