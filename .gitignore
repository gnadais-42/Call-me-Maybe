# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Type checker / test / lint caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.flake8_cache/

# Virtual environments
.venv/
venv/
env/

# uv
